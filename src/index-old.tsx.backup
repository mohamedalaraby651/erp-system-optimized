// ============================================
// Main Application Entry Point
// نظام إدارة الشركات المتكامل (ERP)
// ============================================

import { Hono } from 'hono';
import { cors } from 'hono/cors';
import { logger } from 'hono/logger';
import { serveStatic } from 'hono/cloudflare-workers';

// Import routes
import auth from './routes/auth';
import users from './routes/users';
import dashboard from './routes/dashboard';
import departments from './routes/departments';
import allModules from './routes/all-modules';

import type { Bindings, Variables } from './types';

const app = new Hono<{ Bindings: Bindings; Variables: Variables }>();

// Middleware
app.use('*', logger());
app.use('/api/*', cors());

// Serve static files
app.use('/static/*', serveStatic({ root: './public' }));

// API Routes
app.route('/api/auth', auth);
app.route('/api/users', users);
app.route('/api/dashboard', dashboard);
app.route('/api/departments', departments);
app.route('/api', allModules);

// Health check
app.get('/api/health', (c) => {
  return c.json({ 
    success: true, 
    message: 'نظام إدارة الشركات المتكامل يعمل بنجاح',
    timestamp: new Date().toISOString() 
  });
});

// Main page
app.get('/', (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ar" dir="rtl" data-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>نظام إدارة الشركات المتكامل - ERP</title>
        
        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com"></script>
        
        <!-- Font Awesome -->
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
        
        <!-- Chart.js -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        
        <!-- SheetJS for Excel Export -->
        <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
        
        <!-- jsPDF for PDF Export -->
        <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
        
        <!-- html2canvas for HTML to Canvas -->
        <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
        
        <!-- Axios -->
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        
        <!-- Custom Styles -->
        <link href="/static/styles-enhanced.css" rel="stylesheet">
    </head>
    <body>
        <div id="app"></div>
        
        <!-- JavaScript Files -->
        <script src="/static/app-enhanced.js"></script>
        <script src="/static/app-rendering.js"></script>
        <script src="/static/app-forms.js"></script>
        <script>
            // Global state
            const state = {
                token: localStorage.getItem('token') || null,
                user: JSON.parse(localStorage.getItem('user') || 'null'),
                currentPage: 'login',
                sidebarOpen: true,
                dashboardStats: null,
            };
            
            // API configuration
            const api = axios.create({
                baseURL: '/api',
                headers: {
                    'Content-Type': 'application/json',
                }
            });
            
            // Add token to requests
            api.interceptors.request.use(config => {
                if (state.token) {
                    config.headers.Authorization = \`Bearer \${state.token}\`;
                }
                return config;
            });
            
            // Handle errors
            api.interceptors.response.use(
                response => response,
                error => {
                    if (error.response?.status === 401) {
                        logout();
                    }
                    return Promise.reject(error);
                }
            );
            
            // Authentication functions
            async function login(username, password) {
                try {
                    const response = await api.post('/auth/login', { username, password });
                    if (response.data.success) {
                        state.token = response.data.token;
                        state.user = response.data.user;
                        localStorage.setItem('token', state.token);
                        localStorage.setItem('user', JSON.stringify(state.user));
                        state.currentPage = 'dashboard';
                        render();
                        loadDashboardStats();
                    } else {
                        showError(response.data.error || 'حدث خطأ أثناء تسجيل الدخول');
                    }
                } catch (error) {
                    showError(error.response?.data?.error || 'حدث خطأ أثناء تسجيل الدخول');
                }
            }
            
            function logout() {
                state.token = null;
                state.user = null;
                state.currentPage = 'login';
                localStorage.removeItem('token');
                localStorage.removeItem('user');
                render();
            }
            
            // Dashboard functions
            async function loadDashboardStats() {
                try {
                    const response = await api.get('/dashboard/stats');
                    if (response.data.success) {
                        state.dashboardStats = response.data.data;
                        renderDashboard();
                    }
                } catch (error) {
                    console.error('Error loading dashboard stats:', error);
                }
            }
            
            function showError(message) {
                alert(message);
            }
            
            function showSuccess(message) {
                alert(message);
            }
            
            // Render functions
            function render() {
                const app = document.getElementById('app');
                
                if (!state.token) {
                    app.innerHTML = renderLoginPage();
                    attachLoginHandlers();
                } else {
                    app.innerHTML = renderMainLayout();
                    attachMainHandlers();
                    
                    if (state.currentPage === 'dashboard') {
                        renderDashboard();
                    }
                }
            }
            
            function renderLoginPage() {
                return \`
                    <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-500 to-purple-600">
                        <div class="bg-white rounded-lg shadow-2xl p-8 w-full max-w-md">
                            <div class="text-center mb-8">
                                <i class="fas fa-building text-6xl text-blue-600 mb-4"></i>
                                <h1 class="text-3xl font-bold text-gray-800 mb-2">نظام إدارة الشركات</h1>
                                <p class="text-gray-600">تسجيل الدخول إلى حسابك</p>
                            </div>
                            
                            <form id="loginForm" class="space-y-6">
                                <div>
                                    <label class="block text-gray-700 mb-2 font-semibold">
                                        <i class="fas fa-user ml-2"></i>
                                        اسم المستخدم
                                    </label>
                                    <input 
                                        type="text" 
                                        id="username" 
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                        placeholder="أدخل اسم المستخدم"
                                        required
                                    >
                                </div>
                                
                                <div>
                                    <label class="block text-gray-700 mb-2 font-semibold">
                                        <i class="fas fa-lock ml-2"></i>
                                        كلمة المرور
                                    </label>
                                    <input 
                                        type="password" 
                                        id="password" 
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                        placeholder="أدخل كلمة المرور"
                                        required
                                    >
                                </div>
                                
                                <button 
                                    type="submit" 
                                    class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition duration-200"
                                >
                                    <i class="fas fa-sign-in-alt ml-2"></i>
                                    تسجيل الدخول
                                </button>
                            </form>
                            
                            <div class="mt-6 p-4 bg-blue-50 rounded-lg">
                                <p class="text-sm text-gray-600 text-center">
                                    <i class="fas fa-info-circle ml-1"></i>
                                    للتجربة استخدم: Mohamed / Mohamed@123
                                </p>
                            </div>
                        </div>
                    </div>
                \`;
            }
            
            function renderMainLayout() {
                return \`
                    <div class="min-h-screen bg-gray-50 flex">
                        <!-- Sidebar -->
                        <aside class="sidebar fixed md:relative w-64 bg-gray-900 text-white h-screen overflow-y-auto z-50 \${state.sidebarOpen ? '' : 'hidden'}">
                            <div class="p-6">
                                <div class="flex items-center mb-8">
                                    <i class="fas fa-building text-3xl text-blue-400 ml-3"></i>
                                    <h1 class="text-xl font-bold">نظام ERP</h1>
                                </div>
                                
                                <nav class="space-y-2">
                                    <a href="#" onclick="navigateTo('dashboard')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                        <i class="fas fa-home ml-3"></i>
                                        <span>لوحة التحكم</span>
                                    </a>
                                    
                                    <div class="mt-4">
                                        <p class="text-gray-500 text-xs uppercase mb-2 px-4">الإدارة</p>
                                        <a href="#" onclick="navigateTo('users')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-users ml-3"></i>
                                            <span>المستخدمين</span>
                                        </a>
                                        <a href="#" onclick="navigateTo('departments')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-sitemap ml-3"></i>
                                            <span>الأقسام</span>
                                        </a>
                                        <a href="#" onclick="navigateTo('employees')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-user-tie ml-3"></i>
                                            <span>الموظفين</span>
                                        </a>
                                    </div>
                                    
                                    <div class="mt-4">
                                        <p class="text-gray-500 text-xs uppercase mb-2 px-4">المبيعات والعملاء</p>
                                        <a href="#" onclick="navigateTo('clients')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-handshake ml-3"></i>
                                            <span>العملاء</span>
                                        </a>
                                        <a href="#" onclick="navigateTo('invoices')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-file-invoice ml-3"></i>
                                            <span>الفواتير</span>
                                        </a>
                                    </div>
                                    
                                    <div class="mt-4">
                                        <p class="text-gray-500 text-xs uppercase mb-2 px-4">المحاسبة</p>
                                        <a href="#" onclick="navigateTo('accounting')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-calculator ml-3"></i>
                                            <span>دليل الحسابات</span>
                                        </a>
                                        <a href="#" onclick="navigateTo('journal')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-book ml-3"></i>
                                            <span>القيود المحاسبية</span>
                                        </a>
                                        <a href="#" onclick="navigateTo('reports')" class="nav-item flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 transition">
                                            <i class="fas fa-chart-line ml-3"></i>
                                            <span>التقارير المالية</span>
                                        </a>
                                    </div>
                                </nav>
                            </div>
                            
                            <div class="absolute bottom-0 w-64 p-6 bg-gray-800">
                                <div class="flex items-center mb-3">
                                    <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center ml-3">
                                        <i class="fas fa-user text-white"></i>
                                    </div>
                                    <div>
                                        <p class="font-semibold">\${state.user?.full_name || 'مستخدم'}</p>
                                        <p class="text-xs text-gray-400">\${state.user?.role_name_ar || 'موظف'}</p>
                                    </div>
                                </div>
                                <button onclick="logout()" class="w-full bg-red-600 hover:bg-red-700 py-2 rounded-lg transition">
                                    <i class="fas fa-sign-out-alt ml-2"></i>
                                    تسجيل الخروج
                                </button>
                            </div>
                        </aside>
                        
                        <!-- Main Content -->
                        <main class="flex-1 overflow-y-auto">
                            <!-- Header -->
                            <header class="bg-white shadow-sm p-4 flex items-center justify-between">
                                <button onclick="toggleSidebar()" class="md:hidden text-gray-600">
                                    <i class="fas fa-bars text-2xl"></i>
                                </button>
                                <h2 class="text-2xl font-bold text-gray-800" id="pageTitle">لوحة التحكم</h2>
                                <div class="flex items-center space-x-4 space-x-reverse">
                                    <button class="text-gray-600 hover:text-gray-800 relative">
                                        <i class="fas fa-bell text-xl"></i>
                                        <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                                    </button>
                                </div>
                            </header>
                            
                            <!-- Page Content -->
                            <div id="pageContent" class="p-6">
                                <!-- Content will be rendered here -->
                            </div>
                        </main>
                    </div>
                \`;
            }
            
            function renderDashboard() {
                const stats = state.dashboardStats;
                if (!stats) return;
                
                const content = \`
                    <div class="space-y-6">
                        <!-- Stats Cards -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                            <div class="card stat-card text-white rounded-lg shadow-lg p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm opacity-80">إجمالي الإيرادات</p>
                                        <h3 class="text-3xl font-bold mt-2">\${stats.totalRevenue.toLocaleString('ar-EG')} جنيه</h3>
                                    </div>
                                    <i class="fas fa-dollar-sign text-4xl opacity-50"></i>
                                </div>
                            </div>
                            
                            <div class="card stat-card-green text-white rounded-lg shadow-lg p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm opacity-80">صافي الربح</p>
                                        <h3 class="text-3xl font-bold mt-2">\${stats.netProfit.toLocaleString('ar-EG')} جنيه</h3>
                                    </div>
                                    <i class="fas fa-chart-line text-4xl opacity-50"></i>
                                </div>
                            </div>
                            
                            <div class="card stat-card-orange text-white rounded-lg shadow-lg p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm opacity-80">فواتير معلقة</p>
                                        <h3 class="text-3xl font-bold mt-2">\${stats.pendingInvoices}</h3>
                                    </div>
                                    <i class="fas fa-file-invoice text-4xl opacity-50"></i>
                                </div>
                            </div>
                            
                            <div class="card stat-card-blue text-white rounded-lg shadow-lg p-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-sm opacity-80">إجمالي العملاء</p>
                                        <h3 class="text-3xl font-bold mt-2">\${stats.totalClients}</h3>
                                    </div>
                                    <i class="fas fa-users text-4xl opacity-50"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Additional Info Cards -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="bg-white rounded-lg shadow p-6">
                                <div class="flex items-center mb-4">
                                    <i class="fas fa-user-tie text-2xl text-blue-600 ml-3"></i>
                                    <h3 class="text-lg font-semibold">الموظفين</h3>
                                </div>
                                <p class="text-3xl font-bold text-gray-800">\${stats.totalEmployees}</p>
                                <p class="text-sm text-gray-600 mt-2">موظف نشط</p>
                            </div>
                            
                            <div class="bg-white rounded-lg shadow p-6">
                                <div class="flex items-center mb-4">
                                    <i class="fas fa-truck text-2xl text-green-600 ml-3"></i>
                                    <h3 class="text-lg font-semibold">الموردين</h3>
                                </div>
                                <p class="text-3xl font-bold text-gray-800">\${stats.totalSuppliers}</p>
                                <p class="text-sm text-gray-600 mt-2">مورد نشط</p>
                            </div>
                            
                            <div class="bg-white rounded-lg shadow p-6">
                                <div class="flex items-center mb-4">
                                    <i class="fas fa-exclamation-triangle text-2xl text-red-600 ml-3"></i>
                                    <h3 class="text-lg font-semibold">فواتير متأخرة</h3>
                                </div>
                                <p class="text-3xl font-bold text-red-600">\${stats.overdueInvoices}</p>
                                <p class="text-sm text-gray-600 mt-2">تحتاج متابعة</p>
                            </div>
                        </div>
                        
                        <!-- Welcome Message -->
                        <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg shadow-lg p-8">
                            <h2 class="text-2xl font-bold mb-2">مرحباً، \${state.user?.full_name || 'مستخدم'}!</h2>
                            <p class="opacity-90">نتمنى لك يوم عمل موفق. هذا هو نظام إدارة الشركات المتكامل الخاص بك.</p>
                        </div>
                    </div>
                \`;
                
                document.getElementById('pageContent').innerHTML = content;
            }
            
            function navigateTo(page) {
                state.currentPage = page;
                document.getElementById('pageTitle').textContent = getPageTitle(page);
                
                if (page === 'dashboard') {
                    loadDashboardStats();
                } else {
                    document.getElementById('pageContent').innerHTML = \`
                        <div class="bg-white rounded-lg shadow p-8 text-center">
                            <i class="fas fa-tools text-6xl text-gray-400 mb-4"></i>
                            <h3 class="text-2xl font-bold text-gray-800 mb-2">قسم \${getPageTitle(page)}</h3>
                            <p class="text-gray-600">هذا القسم قيد التطوير ...</p>
                        </div>
                    \`;
                }
            }
            
            function getPageTitle(page) {
                const titles = {
                    dashboard: 'لوحة التحكم',
                    users: 'المستخدمين',
                    departments: 'الأقسام',
                    employees: 'الموظفين',
                    clients: 'العملاء',
                    invoices: 'الفواتير',
                    accounting: 'دليل الحسابات',
                    journal: 'القيود المحاسبية',
                    reports: 'التقارير المالية',
                };
                return titles[page] || page;
            }
            
            function toggleSidebar() {
                state.sidebarOpen = !state.sidebarOpen;
                document.querySelector('.sidebar').classList.toggle('hidden');
            }
            
            function attachLoginHandlers() {
                document.getElementById('loginForm').addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const username = document.getElementById('username').value;
                    const password = document.getElementById('password').value;
                    await login(username, password);
                });
            }
            
            function attachMainHandlers() {
                // Handlers are attached via onclick attributes
            }
            
            // Initialize app
            document.addEventListener('DOMContentLoaded', () => {
                render();
            });
        </script>
    </body>
    </html>
  `);
});

export default app;
